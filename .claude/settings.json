{
  "permissions": {
    "allow": [
      "Bash(bin/rails test)",
      "Bash(bin/rails test *)",
      "Bash(bin/rails runner *)",
      "Bash(bin/rails db:migrate)",
      "Bash(bin/rails generate model *)",
      "Bash(bin/rails generate migration *)"
    ],
    "ask": [
      "Bash(bin/reset-db)"
    ],
    "deny": [
      "Read(/agent-log/**)",
      "Edit(/agent-log/**)",
      "Bash(*agent-log*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/bin/save-log --quiet", "timeout": 30 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/bin/save-log --quiet", "timeout": 10 }
        ]
      }
    ]
  }
}
